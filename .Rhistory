list(
start_time = st,
end_time = end_t,
coefficients = fit$coefficients
)
}
# 6. Cleanup
stopCluster(cl)
# Format output
res_list <- lapply(results, function(x) {
if (is.null(x) || inherits(x, "error")) return(NULL)
c(window = paste(x$start_time, x$end_time, sep = "-"), x$coefficients)
})
results_df <- as.data.frame(do.call(rbind, compact(res_list)))
print(results_df)
library(dplyr)
library(plm)
library(splm)
library(spdep)
library(foreach)
library(doParallel)
set.seed(42)
N <- 30
T_total <- 10
window_size <- 3
df <- expand.grid(id = 1:N, time = 1:T_total)
df <- df %>%
mutate(
y = rnorm(n()),
x = rnorm(n()),
lat = runif(n(), 35, 45),
lon = runif(n(), 6, 18)
)
coords <- df %>% filter(time == 1) %>% select(lon, lat) %>% as.matrix()
nb <- knn2nb(knearneigh(coords, k = 4))
W <- nb2listw(nb, style = "W")
start_times <- 1:(T_total - window_size + 1)
n_cores <- parallel::detectCores() - 1
# outfile = "" forces worker nodes to send their output to the master console
cl <- parallel::makeCluster(n_cores, outfile = "")
registerDoParallel(cl)
results <- foreach(
st = start_times,
.packages = c("dplyr", "plm", "splm"),
.errorhandling = "pass"
) %dopar% {
worker_pid <- Sys.getpid()
end_t <- st + window_size - 1
cat(sprintf("[Worker PID: %d] Processing window %d to %d...\n", worker_pid, st, end_t))
df_window <- df %>% filter(time >= st & time <= end_t)
p_data <- pdata.frame(df_window, index = c("id", "time"))
fit <- tryCatch({
spml(y ~ x, data = p_data, listw = W, model = "within", lag = TRUE, spatial.error = "none")
}, error = function(e) return(NULL))
if (is.null(fit)) return(NULL)
list(
start_time = st,
end_time = end_t,
worker_pid = worker_pid,
coefficients = fit$coefficients
)
}
stopCluster(cl)
res_list <- lapply(results, function(x) {
if (is.null(x) || inherits(x, "error")) return(NULL)
c(
window = paste(x$start_time, x$end_time, sep = "-"),
worker_pid = as.character(x$worker_pid),
x$coefficients
)
})
results_df <- as.data.frame(do.call(rbind, Filter(Negate(is.null), res_list)))
print(results_df)
