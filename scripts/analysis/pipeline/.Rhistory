log_msg("    -> MODEL: Estimating ", model_name, "...")
fit <- tryCatch({
if (m_conf$pkg == "splm") {
spgm(formula, data = p_data, listw = W, model = "within", method = "w2sls",
lag = m_conf$lag, spatial.error = m_conf$spatial.error, Durbin = m_conf$Durbin)
} else {
plm(formula, data = p_data, model = "within", effect = "individual")
}
}, error = function(e) {
log_msg("       [!] FAILED: ", model_name, " | Error: ", e$message)
return(NULL)
})
if (!is.null(fit)) {
fitted_models[[model_name]] <- fit
}
}
return(fitted_models)
}
# One (region, radius, window) unit of work. Returns c(models_attempted, models_failed).
estimate_task <- function(working_df, tk, window_size, granularity, formula, config) {
region_df <- if (tk$region == "Italy") working_df else
working_df %>% filter(!!sym(granularity) == tk$region)
window_data <- prepare_window_data(region_df, tk$start_week, window_size)
if (is.null(window_data)) return(c(0, 0))
aligned_data <- compute_distance_matrix(window_data, tk$rad)
if (is.null(aligned_data)) return(c(0, 0))
fitted_models <- fit_spatial_models(aligned_data$df, aligned_data$W, formula, config)
attempted <- length(config$spatial_models)
failed <- attempted - length(fitted_models)
if (length(fitted_models) > 0) {
create_coef_df(list(
models = fitted_models,
window = window_size,
start_week = tk$start_week,
end_week = tk$end_week,
region = tk$region,
radius = tk$rad,
estimation_granularity = granularity
), tk$file)
}
c(attempted, failed)
}
# ------------------------------------------------------------------------------
# 3. PARALLEL EXECUTION
# ------------------------------------------------------------------------------
run_rolling_estimation <- function(base_data_path, config, formula, radiuses, window_size, step_size = 1,
estimation_granularity = c("nuts0", "nuts1", "nuts2", "nuts3"), output_dir,
sample_fraction = 1.0, random_seed = 42, n_workers = 1) {
estimation_granularity <- match.arg(estimation_granularity)
set.seed(random_seed)
dir.create(output_dir, showWarnings = FALSE, recursive = TRUE)
options(pipeline_log_file = file.path(output_dir,
paste0("pipeline_", format(Sys.time(), "%Y%m%d_%H%M%S"), ".log")))
log_msg("Log file: ", getOption("pipeline_log_file"))
log_msg("LOADING DATA")
base_data <- readRDS(base_data_path)
if (!is.numeric(base_data$df$time_index)) {
log_msg("WARNING: time_index is not numeric. Forcing conversion to sequential integers.")
base_data$df <- base_data$df %>%
mutate(time_index = as.integer(factor(time_index, ordered = TRUE)))
}
working_df <- apply_stratified_sampling(base_data$df, estimation_granularity, sample_fraction, random_seed)
run_config <- list(
timestamp = Sys.time(),
config_params = config,
formula = deparse(formula),
radiuses = radiuses,
window_size = window_size,
step_size = step_size,
estimation_granularity = estimation_granularity,
sample_fraction = sample_fraction,
random_seed = random_seed,
n_workers = n_workers,
sampled_id_pumps = unique(working_df$id_pump)
)
config_file_name <- paste0("run_config_", format(Sys.time(), "%Y%m%d_%H%M%S"), ".RDS")
config_path <- file.path(output_dir, config_file_name)
saveRDS(run_config, config_path)
log_msg("Run configuration and sampled id_pump list saved to: ", config_path)
log_msg("CLEARING MEMORY - remove base_data")
rm(base_data)
gc()
if(estimation_granularity == "nuts0") {
regions <- "Italy"
} else {
regions <- unique(working_df[[estimation_granularity]])
}
min_week <- min(working_df$time_index, na.rm = TRUE)
max_week <- max(working_df$time_index, na.rm = TRUE)
log_msg("Global time_index range: ", min_week, " to ", max_week)
valid_regions <- as.character(regions[!is.na(regions)])
start_weeks_seq <- seq(min_week, max_week - window_size + 1, by = step_size)
# Task grid (same order as the old nested loops). Existing outputs are skipped (resume).
tasks <- expand.grid(start_week = start_weeks_seq, rad = radiuses, region = valid_regions,
stringsAsFactors = FALSE)
tasks$end_week <- tasks$start_week + window_size - 1
tasks$file <- file.path(output_dir, sprintf("res_%s_rad%d_w%03d_w%03d.RDS",
gsub("[^A-Za-z0-9]", "_", tasks$region),
tasks$rad, tasks$start_week, tasks$end_week))
todo <- tasks[!file.exists(tasks$file), ]
n_todo <- nrow(todo)
log_msg("Tasks total: ", nrow(tasks), " | already done: ", nrow(tasks) - n_todo,
" | to run: ", n_todo, " | workers: ", n_workers)
if (n_todo == 0) {
log_msg("Nothing to do.")
return(invisible(NULL))
}
registerDoParallel(cores = n_workers)
# Runs inside a forked process: tag log lines with the task id, never stop the run.
run_one_task <- function(i) {
tk <- todo[i, ]
options(pipeline_tag = sprintf("task %04d %s rad%d w%03d-w%03d",
i, tk$region, tk$rad, tk$start_week, tk$end_week))
t0 <- Sys.time()
log_msg("START (", i, "/", n_todo, ")")
counts <- tryCatch(
estimate_task(working_df, tk, window_size, estimation_granularity, formula, config),
error = function(e) {
log_msg("[!] TASK ERROR: ", conditionMessage(e))
c(0, 0)
}
)
log_msg(sprintf("DONE in %.0f s", as.numeric(difftime(Sys.time(), t0, units = "secs"))))
counts
}
# preschedule = FALSE: one short-lived process per task, at most n_workers alive,
# dynamic balancing, all memory returned to the OS when each task ends.
totals <- foreach(i = seq_len(n_todo), .combine = "+", .init = c(0, 0),
.errorhandling = "remove",
.options.multicore = list(preschedule = FALSE)) %dopar% run_one_task(i)
options(pipeline_tag = NULL)
fail_rate <- (totals[2] / max(1, totals[1])) * 100
log_msg("=== PIPELINE COMPLETE ===")
log_msg(sprintf("Total Models Attempted: %.0f", totals[1]))
log_msg(sprintf("Total Models Failed:    %.0f", totals[2]))
log_msg(sprintf("Failure Rate:           %.2f%%", fail_rate))
}
# ------------------------------------------------------------------------------
# 4. RESULT COLLECTION (unchanged)
# ------------------------------------------------------------------------------
collect_results <- function(directory_path, output_path, pattern = "\\.RDS$") {
file_paths <- list.files(path = directory_path, pattern = pattern, full.names = TRUE)
file_paths <- file_paths[!grepl("run_config", file_paths)]
if (length(file_paths) == 0) {
log_msg("WARNING: No result files matching pattern ", pattern, " found in ", directory_path)
return(NULL)
}
combined_df <- map_dfr(file_paths, function(file) {
tryCatch({
readRDS(file)
}, error = function(e) {
log_msg("WARNING: Failed to read ", file, ": ", e$message)
return(NULL)
})
})
saveRDS(combined_df, output_path)
return(combined_df)
}
